# ─────────────────────────────────────────────────────────────
# Finance App — Environment Variables
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local` (it is already git-ignored).
# ─────────────────────────────────────────────────────────────

# --- Supabase ---
# Project URL: Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key (safe to expose to the browser — RLS protects your data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (SERVER-ONLY. NEVER expose to the browser.)
# Found in Dashboard → Project Settings → API → `service_role` secret.
# Used for admin operations: running RLS-exempt queries, creating users,
# generating the type-safe database types, etc.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional: edge-function secret / rate-limit provider (Phase 6) ---
# RATE_LIMITER=1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI Insights (Phase 6 — future-ready architecture) ---
# ANTHROPIC_API_KEY=
